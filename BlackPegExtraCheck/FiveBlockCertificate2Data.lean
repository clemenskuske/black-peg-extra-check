def fiveLevel2Yes (index : Fin 61) : Fin 6 → Fin 243 :=
  fiveLevel2YesValues[index.val]'(by simpa [fiveLevel2YesValues] using index.isLt)

def fiveLevel2No (index : Fin 61) : Fin 6 → Fin 243 :=
  fiveLevel2NoValues[index.val]'(by simpa [fiveLevel2NoValues] using index.isLt)

def fiveLevel2Check (index : Fin 61) (black : Fin 11) : Fin 10 × Fin 11 :=
  match fiveResidualBlack? black with
  | some residual => fiveLevel2CheckReduced index residual
  | none => (0, 0)

def fiveLevel2Next (index : Fin 61) (black : Fin 11) (bit : Bool) : Fin 243 :=
  match fiveResidualBlack? black with
  | some residual =>
      if bit then fiveLevel2Yes index residual else fiveLevel2No index residual
  | none => 0

def fiveLevel2Guess (_index : Fin 61) : TenElevenSecret := fiveBlockGuess 2

def fiveLevel3State (index : Fin 243) : Finset TenElevenSecret :=
  let descriptor := fiveLevel3Descriptor index
  checkedBranch (fiveLevel2State descriptor.1) (fiveBlockGuess 2)
    (fiveFullBlack descriptor.2.1)
    (fiveLevel2CheckReduced descriptor.1 descriptor.2.1) descriptor.2.2

abbrev fiveLevel2TransitionAt (node : Fin 61) : Prop :=
  ∀ black bit,
    checkedBranch (fiveLevel2State node) (fiveLevel2Guess node) black
      (fiveLevel2Check node black) bit =
        fiveLevel3State (fiveLevel2Next node black bit)

end BlackPegExtraCheck
