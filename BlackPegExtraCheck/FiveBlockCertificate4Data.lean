def fiveLevel4Yes (index : Fin 565) : Fin 6 → Fin 721 :=
  fiveLevel4YesValues[index.val]'(by simpa [fiveLevel4YesValues] using index.isLt)

set_option maxRecDepth 3000 in
def fiveLevel4No (index : Fin 565) : Fin 6 → Fin 721 :=
  fiveLevel4NoValues[index.val]'(by simpa [fiveLevel4NoValues] using index.isLt)

def fiveLevel4Check (index : Fin 565) (black : Fin 11) : Fin 10 × Fin 11 :=
  match fiveResidualBlack? black with
  | some residual => fiveLevel4CheckReduced index residual
  | none => (0, 0)

def fiveLevel4Next (index : Fin 565) (black : Fin 11) (bit : Bool) : Fin 721 :=
  match fiveResidualBlack? black with
  | some residual =>
      if bit then fiveLevel4Yes index residual else fiveLevel4No index residual
  | none => 0

def fiveLevel4Guess (_index : Fin 565) : TenElevenSecret := fiveBlockGuess 4

def fiveLevel5State (index : Fin 721) : Finset TenElevenSecret :=
  let descriptor := fiveLevel5Descriptor index
  checkedBranch (fiveLevel4State descriptor.1) (fiveBlockGuess 4)
    (fiveFullBlack descriptor.2.1)
    (fiveLevel4CheckReduced descriptor.1 descriptor.2.1) descriptor.2.2

abbrev fiveLevel4TransitionAt (node : Fin 565) : Prop :=
  ∀ black bit,
    checkedBranch (fiveLevel4State node) (fiveLevel4Guess node) black
      (fiveLevel4Check node black) bit =
        fiveLevel5State (fiveLevel4Next node black bit)

