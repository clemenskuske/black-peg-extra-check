set_option maxRecDepth 2000 in
def fiveLevel3Yes (index : Fin 243) : Fin 6 → Fin 565 :=
  fiveLevel3YesValues[index.val]'(by simpa [fiveLevel3YesValues] using index.isLt)

set_option maxRecDepth 2000 in
def fiveLevel3No (index : Fin 243) : Fin 6 → Fin 565 :=
  fiveLevel3NoValues[index.val]'(by simpa [fiveLevel3NoValues] using index.isLt)

def fiveLevel3Check (index : Fin 243) (black : Fin 11) : Fin 10 × Fin 11 :=
  match fiveResidualBlack? black with
  | some residual => fiveLevel3CheckReduced index residual
  | none => (0, 0)

def fiveLevel3Next (index : Fin 243) (black : Fin 11) (bit : Bool) : Fin 565 :=
  match fiveResidualBlack? black with
  | some residual =>
      if bit then fiveLevel3Yes index residual else fiveLevel3No index residual
  | none => 0

def fiveLevel3Guess (_index : Fin 243) : TenElevenSecret := fiveBlockGuess 3

def fiveLevel4State (index : Fin 565) : Finset TenElevenSecret :=
  let descriptor := fiveLevel4Descriptor index
  checkedBranch (fiveLevel3State descriptor.1) (fiveBlockGuess 3)
    (fiveFullBlack descriptor.2.1)
    (fiveLevel3CheckReduced descriptor.1 descriptor.2.1) descriptor.2.2

abbrev fiveLevel3TransitionAt (node : Fin 243) : Prop :=
  ∀ black bit,
    checkedBranch (fiveLevel3State node) (fiveLevel3Guess node) black
      (fiveLevel3Check node black) bit =
        fiveLevel4State (fiveLevel3Next node black bit)

end BlackPegExtraCheck
